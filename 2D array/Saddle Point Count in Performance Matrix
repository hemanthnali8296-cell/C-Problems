#include <stdio.h>
int main() {
    int R, C;
    scanf("%d %d", &R, &C);
    int a[R][C];
    for(int i = 0; i < R; i++) {
        for(int j = 0; j < C; j++) {
            scanf("%d", &a[i][j]);
        }
    }
    int count = 0;
    for(int i = 0; i < R; i++) {
        int min_col = 0;
        for(int j = 1; j < C; j++) {
            if(a[i][j] < a[i][min_col]) {
                min_col = j;
            }
        }
        int isSaddle = 1;
        for(int k = 0; k < R; k++) {
            if(a[k][min_col] > a[i][min_col]) {
                isSaddle = 0;
                break;
            }
        }
        if(isSaddle) {
            count++;
        }
    }
    printf("%d\n", count);
    return 0;
}
