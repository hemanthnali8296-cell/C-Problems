#include<stdio.h>
int main(){
   int n,heart_rate,count=0;
   int max=0;
   scanf("%d",&n);
   for(int i=0;i<n;i++){
      scanf("%d",&heart_rate);
      if(heart_rate>max){
         max=heart_rate;
      }
      if(heart_rate>140){
         count++;
      }
   }
   printf("Max Heart Rate: %d\n",max);
   printf("Danger Readings: %d",count);
}
