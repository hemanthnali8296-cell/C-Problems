#include<stdio.h>
int main(){
     int n,score,total=0,count=0;
     scanf("%d",&n);
     for(int i=0;i<n;i++){
        scanf("%d",&score);
        total+=score;
        if(score>50){
              count++;
        }
     }
     printf("Total Risk: %d\n",total);
     printf("High Risk Sessions: %d",count);
   return 0;
}
