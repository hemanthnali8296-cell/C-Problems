#include<stdio.h>
int main(){
    int n,expence,total=0,morespend=0;
    scanf("%d",&n);
    for(int i=0;i<n;i++){
        scanf("%d",&expence);
    
        total+=expence;
    
        if(expence>1000){
            morespend++;
        }
    }
    printf("%d\n",total);
      printf("%d\n",morespend);
    return 0;
}
