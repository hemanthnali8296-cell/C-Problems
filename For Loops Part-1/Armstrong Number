#include<stdio.h>
int main(){
    int n,org,digit=0,rem;
    scanf("%d",&n);
   int sum=0;
   org=n;
   for(int temp=n;temp!=0;temp/=10){
    digit++;
   }
    for(int temp=n;temp!=0;temp/=10){
        rem=temp%10;
        int pow=1;
        for(int i=0;i<digit;i++){
            pow=pow*rem;
        }
        sum+=pow;
    }
    if(sum==org){
        printf("Yes");
    }else{
        printf("No");
    }
   
    return 0;
}
