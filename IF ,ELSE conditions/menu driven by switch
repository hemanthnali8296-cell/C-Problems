#include <stdio.h>
int main() {
     int a,b,result=0;
     int o;
     scanf("%d %d %d",&a,&b,&o);
     switch(o){
        case 1:
        result=a+b;
        printf("%d",result);
        break;
        case 2:
        result=a-b;
        printf("%d",result);
        break;
        case 3:
        result=a*b;
        printf("%d", result);
        break;
        case 4:
         result=a/b;
        printf("%d", result);
        break;
        case 5:
         result=a%b;
        printf("%d", result);
        break;
     }
    return 0;
}
