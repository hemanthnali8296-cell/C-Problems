#include <stdio.h>
int main() {
    float a, b, result;
    char op;
    printf("Enter two numbers: ");
    scanf("%f %f", &a, &b);
 scanf(" %c", &op); 
 switch (op) {
            case '+':
            result = a + b;
            printf("Result = %.2f", result);
            break;
           case '-':
            result = a - b;
            printf("Result = %.2f", result);
            break;
              case '*':
            result = a * b;
            printf("Result = %.2f", result);
            break;
        case '/':
                result = a / b;
                printf("Result = %.2f", result);
            break;
        default:
            printf("Invalid operator");
    }
   return 0;
}
