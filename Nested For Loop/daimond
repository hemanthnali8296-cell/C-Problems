#include<stdio.h>
int main(){
    int  n;
    scanf("%d",&n);
    for(int a=1;a<=n;a++){
        for(int b=1;b<=n-a;b++){
            printf("  ");
        }for(int c=1;c<=a*2-1;c++){
            printf("* ");
        }
        printf("\n");
    }
    for(int i=n;i>=1;i--){
        for(int space=1;space<=n-i;space++){
            printf("  ");                    
        }for(int j=1;j<=i*2-1;j++){
            printf("* ");
        }
        printf("\n");
    }
    return 0;
}
