#include <stdio.h>
int main() {
    int type,weight,charge=0;
    scanf("%d %d",&type,&weight);
    switch(type){
        case 1:
        charge=weight*300;
        printf(" Extra baggage Charge ₹ %d",charge);
    break;
    case 2:
    if(weight<=3&&weight>=1){
        charge=0;
        printf("No Charge");
    }else if(weight>3){
        charge=(weight-3)*300;
        printf(" Extra baggage Charge ₹ %d",charge);
    }
        default:
        printf("Invalid Class");
    }
    return 0;
}
