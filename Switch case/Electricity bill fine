#include <stdio.h>
int main() {
    int days,fine=0;
    scanf("%d",&days);
    switch(days){
        case 1:
        case 2:
        case 3:
        case 4:
        case 5:
          fine=days*50;
          printf("%d",fine);
          break;
          case 6:
          case 7:
          case 8:
          case 9:
          case 10:
          fine=days*100;
          printf("%d",fine);
          break;
          default:
          fine=days*200;
          printf("%d",fine);
          break;
    }
}
