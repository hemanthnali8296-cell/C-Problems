#include <stdio.h>
int main() {
    int  type,days,fine=0;
    scanf("%d %d",&type,&days);
    switch(type){
        case 1:
          fine=days*2;
          printf(" Late Fee ₹ %d",fine);
          break;
          case 2:
          fine=days*5;
          printf("Late Fee ₹ %d",fine);
          break;
    }
}
