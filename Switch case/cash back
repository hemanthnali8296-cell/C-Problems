#include <stdio.h>
int main() {
    int Type, paymentMode;
    int amount = 0, cashback = 0;
    scanf("%d", &Type);
    scanf("%d", &paymentMode);
    switch (Type) {
        case 1:
            amount = 199;
            switch (paymentMode) {
                case 11:   
                case 12: 
                    cashback = 20;
                    break;
                case 13: 
             cashback = 0;
                    break;
                default:
                    printf("Invalid payment mode");
                    return 0;
            }
            break;
        case 2:
            amount = 399;
            switch (paymentMode) {
                case 11:   
                case 12:   
                    cashback = 20;
                    break;
                case 13:  
                    cashback = 0;
                    break;
                default:
                    printf("Invalid payment mode");
                    return 0;
            }
            break;
        default:
            printf("Invalid plan type");
            return 0;
    }
    printf("Pay : %d", amount - cashback);
    return 0;
    }

