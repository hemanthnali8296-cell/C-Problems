#include <stdio.h>

struct Book
{
    int bookId;
    char bookName[50];
    float price;
};

int main()
{
    struct Book b;

    printf("Enter Book ID: ");
    scanf("%d", &b.bookId);

    printf("Enter Book Name: ");
    scanf("%s", b.bookName);

    printf("Enter Book Price: ");
    scanf("%f", &b.price);

    printf("\n--- Book Details ---\n");
    printf("Book ID    : %d\n", b.bookId);
    printf("Book Name  : %s\n", b.bookName);
    printf("Price      : %.2f\n", b.price);

    return 0;
}
