#include <stdio.h>

struct Employee
{
    int empId;
    char name[50];
    float salary;
};

int main()
{
    struct Employee e[5];
    int i, max = 0;

    printf("Enter details of 5 employees:\n");

    for(i = 0; i < 5; i++)
    {
        printf("\nEmployee %d\n", i + 1);

        printf("Enter Employee ID: ");
        scanf("%d", &e[i].empId);

        printf("Enter Name: ");
        scanf("%s", e[i].name);

        printf("Enter Salary: ");
        scanf("%f", &e[i].salary);
    }

    for(i = 1; i < 5; i++)
    {
        if(e[i].salary > e[max].salary)
        {
            max = i;
        }
    }

    printf("\n--- Employee with Highest Salary ---\n");
    printf("Employee ID : %d\n", e[max].empId);
    printf("Name        : %s\n", e[max].name);
    printf("Salary      : %.2f\n", e[max].salary);

    return 0;
}
