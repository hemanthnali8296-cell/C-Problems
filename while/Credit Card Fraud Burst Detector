#include <stdio.h>
int main() {
    int n;
    scanf("%d",&n);
    int arr[n];
    int i = 0;
    while (i<n){
        scanf("%d",&arr[i]);
        i++;
    }
    int highValueCount=0,consecutive=0,fraudAttempt=-1;
    i = 0;
    while (i<n){
        if (arr[i]>=50000) {
            highValueCount++;
            consecutive++;
            if (consecutive==3&& fraudAttempt==-1) {
                fraudAttempt = i+1; 
            }
        } else {
            consecutive=0; 
        }
        i++;
    }
    if (fraudAttempt!=-1) {
        printf("Fraud Triggered At Attempt: %d\n",fraudAttempt);
    } else {
        printf("Fraud Triggered At Attempt: Not Triggered\n");
    }
    printf("High-Value Transactions: %d\n",highValueCount);
    return 0;
}
